.vscode/*
.DS_Store
**/.DS_Store
# certgen's scratch directory, wherever it sits. Not anchored to tools/certgen on
# purpose: a checkout made before certgen moved keeps its old, untracked temp/ on
# disk (git does not remove ignored files when branches move it), and an anchored
# rule would stop covering it and surface every generated key as untracked.
**/certgen/temp/
**/certs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
*.so
# The prebuilt adapter libraries are committed artefacts, not Python build output.
# These need the ** and the .so.N suffixes: the old `!image-iris/uacbin/*.so` rule
# matched neither the per-architecture subdirectories nor libopen62541.so.0, which
# is why arm64/irisopcua.so was never committed.
!bin/unix/**/*.so
!bin/unix/**/*.so.*
.venv/
venv/
env/
.env
*.pyo
.python-version
pip-log.txt
pip-delete-this-directory.txt

# Node / Angular
node_modules/
webapp/dist/
.angular/

# Working notes (not for the open-source repo)
docs/notes/