Include (OPCUA.Constants, %occInclude, Ensemble)

/// The Portal path end to end with the schema the console ships: generated by
/// <method>OPCUA.REST.SchemaService.GenerateSchemaClass</method>, so every column is
/// an <tt>OPCUA.Types.*DataValue</tt>. <class>OPCUA.Tests.Live.PortalPipelineTest</class>
/// covers the same path with a hand-written plain-column schema.
///
/// Adds a service item to OPCUA.Pipeline.Production with the Ens.Config API, as the
/// Production Configuration page does, lets it poll the docker plc server, and
/// asserts that a stored row carries all four parts of each measurement in SQL.
Class OPCUA.Tests.Live.PortalDataValuePipelineTest Extends %UnitTest.TestCase
{

Parameter SchemaClass = "OPCUA.Tests.Tmp.PortalDVSchema";

Parameter ItemName = "ZZPortalDataValueTest";

Parameter ProductionClass = "OPCUA.Pipeline.Production";

/// Whether the pipeline production was running before the suite.
Property WasRunning As %Boolean [ InitialExpression = 0 ];

/// Never stops a production it does not own.
Method OnBeforeAllTests() As %Status
{
    set tSC = ##class(OPCUA.REST.DeployService).CheckNoOtherProduction()
    Quit:$$$ISERR(tSC) tSC
    do ##class(Ens.Director).GetProductionStatus(.tRunning, .tState)
    set ..WasRunning = (tRunning = ..#ProductionClass) && (tState = 1)
    Quit ..Cleanup()
}

/// A cleanup that fails is reported as a failure of the suite.
Method OnAfterAllTests() As %Status
{
    set tSC = ..Cleanup()
    do ##class(Ens.Director).GetProductionStatus(.tRunning, .tState)
    set tIsRunning = (tRunning = ..#ProductionClass) && (tState = 1)
    if ..WasRunning && 'tIsRunning {
        do ##class(Ens.Director).StartProduction(..#ProductionClass)
    } elseif '..WasRunning && tIsRunning {
        do ##class(Ens.Director).StopProduction(10, 1)
    }
    Quit tSC
}

Method TestDataValueRow()
{
    set tCols = []
    for tName = "SA1", "SA2", "VT5" {
        do tCols.%Push({"displayName": (tName), "inferredType": "OPCUA.Types.IntegerDataValue", "relativePath": [(tName)]})
    }
    set tSC = ##class(OPCUA.REST.SchemaService).GenerateSchemaClass(..#SchemaClass, "TmpPortalDVSchema", tCols, 1, .tColNS, .tSerial)
    do $$$AssertStatusOK(tSC, "DataValue schema generated")
    Quit:$$$ISERR(tSC)
    set tProp = ##class(%Dictionary.CompiledProperty).%OpenId(..#SchemaClass_"||SA1")
    do $$$AssertEquals($Select($IsObject(tProp):tProp.Type, 1:""), "OPCUA.Types.IntegerDataValue", "SA1 is a DataValue column")

    // A Portal user adds the item to the production they already have.
    set tHave = ##class(%Dictionary.ClassDefinition).%ExistsId(..#ProductionClass)
    do $$$AssertTrue(tHave, ..#ProductionClass_" exists")
    Quit:'tHave
    set tSC = ..AddItem()
    do $$$AssertStatusOK(tSC, "config item added and production started")
    Quit:$$$ISERR(tSC)

    // Poll for a row instead of sleeping a fixed time.
    set tStart = $ZHorolog, tCount = 0
    for {
        set tCount = ..RowCount()
        quit:tCount>0
        quit:(($ZHorolog-tStart)>=30)
        hang 0.5
    }
    do $$$AssertTrue(tCount > 0, "a row was polled within 30 s ("_tCount_" rows after "_$FNumber($ZHorolog - tStart, "", 1)_" s)")
    Quit:tCount=0

    set tTable = ##class(OPCUA.REST.SchemaService).TableName(..#SchemaClass)
    set tRS = ##class(%SQL.Statement).%ExecDirect(, "SELECT TOP 1 NodePath, SA1_Value, SA1_Status, SA1_SourceTS, SA1_ServerTS, VT5_Value, VT5_SourceTS FROM "_tTable_" ORDER BY ID DESC")
    do $$$AssertEquals(tRS.%SQLCODE, 0, "SQL query runs: "_tRS.%Message)
    Quit:tRS.%SQLCODE'=0
    do $$$AssertTrue(tRS.%Next(), "SQL returns the row")
    do $$$AssertEquals(tRS.%Get("NodePath"), "Objects", "NodePath is the device label")
    do $$$AssertNotEquals(tRS.%Get("SA1_Value"), "", "SA1_Value is not NULL")
    do $$$AssertNotEquals(tRS.%Get("SA1_Status"), "", "SA1_Status is not NULL")
    do $$$AssertEquals(tRS.%Get("SA1_Status"), 0, "SA1_Status is Good")
    do $$$AssertNotEquals(tRS.%Get("SA1_SourceTS"), "", "SA1_SourceTS is not NULL")
    do $$$AssertNotEquals(tRS.%Get("SA1_ServerTS"), "", "SA1_ServerTS is not NULL")
    do $$$AssertNotEquals(tRS.%Get("VT5_Value"), "", "VT5_Value is not NULL")
    do $$$AssertNotEquals(tRS.%Get("VT5_SourceTS"), "", "VT5_SourceTS is not NULL")
}

/// Add the service item as the Production Configuration page would, and start
/// or update the production.
ClassMethod AddItem() As %Status
{
    #dim tSC As %Status = $$$OK
    try {
        set tProd = ##class(Ens.Config.Production).%OpenId(..#ProductionClass)
        if '$IsObject(tProd) $$$ThrowStatus($$$ERROR($$$GeneralError, "Cannot open "_..#ProductionClass))
        set tItem = ##class(Ens.Config.Item).%New()
        set tItem.Name = ..#ItemName
        set tItem.ClassName = "OPCUA.Service.TCPPollingRowSourceService"
        set tItem.PoolSize = 1
        set tItem.Enabled = 1
        for tPair = $ListBuild("DataSourceClass", ..#SchemaClass), $ListBuild("DeviceNodePaths", "i=85|Objects"), $ListBuild("URL", ..URL()), $ListBuild("CallInterval", 2) {
            set tS = ##class(Ens.Config.Setting).%New()
            set tS.Target = "Adapter", tS.Name = $ListGet(tPair, 1), tS.Value = $ListGet(tPair, 2)
            do tItem.Settings.Insert(tS)
        }
        do tProd.Items.Insert(tItem)
        $$$ThrowOnError(tProd.%Save())
        $$$ThrowOnError(tProd.SaveToClass())
        $$$ThrowOnError(##class(OPCUA.REST.DeployService).StartOrUpdateProduction())
    } catch e {
        set tSC = e.AsStatus()
    }
    Quit tSC
}

/// The live server, as set by <method>OPCUA.Tests.Runner.Live</method>.
ClassMethod URL() As %String [ CodeMode = expression ]
{
$Get(^||OPCUA.Tests("url"), "opc.tcp://plc")
}

ClassMethod RowCount() As %Integer
{
    set tRS = ##class(%SQL.Statement).%ExecDirect(, "SELECT COUNT(*) FROM "_##class(OPCUA.REST.SchemaService).TableName(..#SchemaClass))
    Quit $Select(tRS.%SQLCODE'=0:0, tRS.%Next():tRS.%GetData(1), 1:0)
}

/// Remove the item (and its config row) and the schema with its rows. Returns
/// the error if the item could not be removed.
ClassMethod Cleanup() As %Status
{
    set tSC = $$$OK
    try {
        set tProd = ##class(Ens.Config.Production).%OpenId(..#ProductionClass)
        if $IsObject(tProd) {
            for i=tProd.Items.Count():-1:1 {
                set tItem = tProd.Items.GetAt(i)
                continue:tItem.Name'=..#ItemName
                set tId = tItem.%Id()
                do tProd.Items.RemoveAt(i)
                $$$ThrowOnError(tProd.%Save())
                $$$ThrowOnError(tProd.SaveToClass())
                do:tId'="" ##class(Ens.Config.Item).%DeleteId(tId)
                do ##class(Ens.Director).GetProductionStatus(.tRunning, .tState)
                if (tRunning = ..#ProductionClass) && (tState = 1) $$$ThrowOnError(##class(Ens.Director).UpdateProduction())
            }
        }
    } catch e {
        set tSC = $$$ERROR($$$GeneralError, "Cleanup of "_..#ItemName_" failed: "_e.DisplayString())
    }
    set tItemName = ..#ItemName
    &sql(DELETE FROM Ens_Util.Log WHERE ConfigName = :tItemName)
    if ##class(%Dictionary.CompiledClass).%ExistsId(..#SchemaClass) {
        try { do $classmethod(..#SchemaClass, "%KillExtent") } catch eKill {}
    }
    do:##class(%Dictionary.ClassDefinition).%ExistsId(..#SchemaClass) $System.OBJ.Delete(..#SchemaClass, "-d")
    kill ^OPCUA.DataSource(..#SchemaClass)
    Quit tSC
}

}
