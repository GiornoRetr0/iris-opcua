Include (OPCUA.Constants, %occInclude)

/// Resolve a device schema plus a device list into a concrete adapter
/// specification, by browsing each device and matching its children by name
/// against the schema's OPCUANODENAME parameters (PRD "Baustein 2").
///
/// This is what replaces the frozen absolute node IDs that the wizard used to
/// capture at deploy time and store in ^OPCUA.RowSource: a device binding is now
/// just a node path, and the concrete node IDs behind each column are discovered
/// at connect time. A device that comes online, or gains a node, between two
/// connects is therefore picked up automatically.
///
/// Matching is by name, preferring the stable BrowseName and falling back to the
/// localized DisplayName (schemas generated by the wizard populate OPCUANODENAME
/// from DisplayName, so the fallback is what makes existing schemas resolve).
/// A column whose node is absent simply gets mask bit 0 and stores NULL, which
/// preserves the semantics of the old precomputed column masks.
Class OPCUA.DataSource.Resolver
{

/// Parse the DeviceNodePaths setting into a device list.
///
/// One device per line. Accepted forms per line:
///   ns=2;s=Plant.AC1        → string NodeId
///   ns=2;i=1047             → numeric NodeId
///   i=85 / s=Foo            → NodeId in namespace 0
/// An optional label may follow a pipe, and becomes the NodePath column value:
///   ns=2;s=Plant.AC1|AC1    → NodePath reads "AC1"
/// Without a label the NodePath column holds the nodepath as written.
///
/// Blank lines and lines starting with # are ignored, so a device list can be
/// commented. Lines are separated by LF, CR or CRLF.
///
/// Output: pDevices = $LB($LB(ns, id, idType, label), ...)
ClassMethod ParseDeviceNodePaths(pSetting As %String, Output pDevices As %List, Output pErrors As %List) As %Status
{
	#dim tSC As %Status = $$$OK
	set pDevices = ""
	set pErrors = ""
	Try {
		// Normalise CRLF / CR line endings to LF, then split.
		set tText = $Replace(pSetting, $Char(13, 10), $Char(10))
		set tText = $Replace(tText, $Char(13), $Char(10))

		for iLine=1:1:$Length(tText, $Char(10)) {
			set tLine = $ZStrip($Piece(tText, $Char(10), iLine), "<>W")
			continue:tLine=""
			continue:$Extract(tLine)="#"

			// Optional "|label" suffix
			set tLabel = ""
			if tLine [ "|" {
				set tLabel = $ZStrip($Piece(tLine, "|", 2, *), "<>W")
				set tLine = $ZStrip($Piece(tLine, "|", 1), "<>W")
			}
			if tLabel = "" set tLabel = tLine

			set tSCLine = ..ParseNodePath(tLine, .tNS, .tId, .tIdType)
			if $$$ISERR(tSCLine) {
				set pErrors = pErrors _ $LB("Line "_iLine_" ("_tLine_"): "_$System.Status.GetOneErrorText(tSCLine))
				continue
			}

			set pDevices = pDevices _ $LB($LB(tNS, tId, tIdType, tLabel))
		}

		if $LL(pDevices) = 0 {
			set tSC = $$$ERROR($$$GeneralError, "DeviceNodePaths did not yield any usable device entries")
		}
	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Parse one nodepath into namespace, identifier and identifier type.
/// Supports the OPC UA textual NodeId forms "ns=<n>;s=<string>" and
/// "ns=<n>;i=<int>", with the ns= part optional (defaults to namespace 0).
ClassMethod ParseNodePath(pPath As %String, Output pNS As %Integer, Output pId, Output pIdType As %Integer) As %Status
{
	set pNS = 0
	set pId = ""
	set pIdType = $$$OpcuaNodeIdTypeString

	set tRest = pPath

	// Leading "ns=<n>;"
	if $ZConvert($Extract(tRest, 1, 3), "L") = "ns=" {
		set tNSPart = $Piece(tRest, ";", 1)
		set tNSVal = $Extract(tNSPart, 4, *)
		if tNSVal '? 1.N {
			Quit $$$ERROR($$$GeneralError, "namespace must be numeric in 'ns=<n>;...'")
		}
		set pNS = +tNSVal
		set tRest = $Piece(tRest, ";", 2, *)
	}

	if tRest = "" {
		Quit $$$ERROR($$$GeneralError, "missing node identifier — expected 's=<name>' or 'i=<number>'")
	}

	set tKind = $ZConvert($Extract(tRest, 1, 2), "L")
	set tVal = $Extract(tRest, 3, *)

	if tKind = "s=" {
		if tVal = "" Quit $$$ERROR($$$GeneralError, "empty string identifier in 's='")
		set pId = tVal
		set pIdType = $$$OpcuaNodeIdTypeString
		Quit $$$OK
	}

	if tKind = "i=" {
		if tVal '? 1.N Quit $$$ERROR($$$GeneralError, "numeric identifier expected in 'i='")
		set pId = +tVal
		set pIdType = $$$OpcuaNodeIdTypeNumeric
		Quit $$$OK
	}

	if tKind = "g=" {
		if tVal = "" Quit $$$ERROR($$$GeneralError, "empty GUID identifier in 'g='")
		set pId = tVal
		set pIdType = $$$OpcuaNodeIdTypeGUID
		Quit $$$OK
	}

	if tKind = "b=" {
		if tVal = "" Quit $$$ERROR($$$GeneralError, "empty ByteString identifier in 'b='")
		set pId = tVal
		set pIdType = $$$OpcuaNodeIdTypeByteString
		Quit $$$OK
	}

	// Browse-path form (e.g. /Plant/AC1) is not supported yet — see PRD Q1,
	// which ships the NodeId form first.
	if $Extract(pPath) = "/" {
		Quit $$$ERROR($$$GeneralError, "browse-path form is not supported yet — use ns=<n>;s=<name> or ns=<n>;i=<number>")
	}

	Quit $$$ERROR($$$GeneralError, "unrecognised nodepath — expected ns=<n>;s=<name> or ns=<n>;i=<number>")
}

/// Read the schema's column layout from the compiled class.
///
/// Walks ^OPCUA.DataSource(schemaClass) — written by
/// <class>OPCUA.DataSource.Projection</class> at compile time — in storage
/// order, which is exactly the order the runtime services index columns by, so
/// mask index and column index stay aligned.
///
/// Output: pColumns(i) = $LB(propertyPath, namespace, nodeName, attributeId, folderName)
/// where folderName is "" for a flat column, or the OPCUANODENAME of the
/// enclosing %SerialObject folder for a nested one. Nested columns must be
/// resolved one level deeper, under their folder's node.
ClassMethod GetSchemaColumns(pSchemaClass As %String, Output pColumns, Output pFolders) As %Status
{
	#dim tSC As %Status = $$$OK
	kill pColumns, pFolders
	set pColumns = 0
	Try {
		set tSpec = $Get(^OPCUA.DataSource(pSchemaClass))
		if tSpec = "" {
			set tSC = $$$ERROR($$$GeneralError, "No compiled OPC UA spec found for "_pSchemaClass_" — is the class compiled?")
			Quit
		}

		set tColumnSpec = $LI(tSpec, 3)

		// Map each property path prefix that is a %SerialObject folder to the
		// folder's OPC UA node name, so nested columns know their parent.
		set tSC = ..MapSerialFolders(pSchemaClass, .tFolderMap)
		Quit:$$$ISERR(tSC)

		// Position 1 of the column spec is the class marker; columns start at 2.
		for i=2:1:$LL(tColumnSpec) {
			set tEntry = $LI(tColumnSpec, i)
			continue:tEntry=""

			set tPropPath = $LI(tEntry, 2)
			set tNamespace = $LI(tEntry, 3)
			set tNodeName = $LI(tEntry, 4)
			set tAttrId = $LI(tEntry, 5)

			// A nested column's property path is "[DS].Folder.Leaf" — one segment
			// deeper than a flat column's "[DS].Leaf".
			set tFolderName = ""
			if $Length(tPropPath, ".") > 2 {
				set tParentPath = $Piece(tPropPath, ".", 1, $Length(tPropPath, ".") - 1)
				set tFolderName = $Get(tFolderMap(tParentPath))
			}

			set pColumns = pColumns + 1
			set pColumns(pColumns) = $LB(tPropPath, tNamespace, tNodeName, tAttrId, tFolderName)
			set:tFolderName'="" pFolders(tFolderName) = ""
		}

		if pColumns = 0 {
			set tSC = $$$ERROR($$$GeneralError, "Schema "_pSchemaClass_" declares no OPC UA columns")
		}
	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Build a map of property path → OPC UA node name for every %SerialObject
/// folder property in the schema class. Used to attribute nested columns to
/// their folder, and by the runtime services to derive the nesting layout.
ClassMethod MapSerialFolders(pSchemaClass As %String, Output pFolderMap) As %Status
{
	#dim tSC As %Status = $$$OK
	kill pFolderMap
	Try {
		set tClassDef = ##class(%Dictionary.CompiledClass).%OpenId(pSchemaClass)
		if '$IsObject(tClassDef) {
			set tSC = $$$ERROR($$$GeneralError, "Cannot open compiled class: "_pSchemaClass)
			Quit
		}

		set tDSName = ""
		for i=1:1:tClassDef.Parameters.Count() {
			set tParam = tClassDef.Parameters.GetAt(i)
			if tParam.Name = "OPCUADATASOURCE" set tDSName = tParam.Default
		}

		for i=1:1:tClassDef.Properties.Count() {
			set tProp = tClassDef.Properties.GetAt(i)
			set tType = tProp.Type
			continue:$Extract(tType,1)="%"
			continue:$Extract(tType,1,12)="OPCUA.Types."
			continue:$Extract(tType,1,16)="OPCUA.Structure."

			Try {
				if $classmethod(tType, "%Extends", "%SerialObject") {
					set tNodeName = tProp.Parameters.GetAt("OPCUANODENAME")
					if tNodeName = "" set tNodeName = tProp.Name
					// Property path as the Projection builds it: "[DSName].PropName"
					set pFolderMap("["_tDSName_"]."_tProp.Name) = tNodeName
				}
			} Catch (eInner) {
				// Type class may not exist — not a folder we can descend into.
			}
		}
	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Derive the nesting layout for a schema from its compiled class.
///
/// The row-source services need to know how flat leaf values map onto the
/// %SerialObject structure of a storage row. That layout used to be precomputed
/// at deploy time and stored in ^OPCUA.RowSource; it is instead derived here from
/// the class itself, which cannot go stale.
///
/// Walks the class's storage order (the same order the column masks use) and
/// emits one entry per storage slot:
///   $LB("leaf", leafIndex)                  — a direct value
///   $LB("serial", folderName, innerSpec)     — an embedded serial object
/// where innerSpec is a list of $LB("leaf", leafIndex) for the folder's own
/// properties, in the serial class's storage order.
///
/// leafIndex numbering matches the order GetSchemaColumns() reports columns in,
/// so the services can index resolved values directly.
///
/// Returns "" when the schema has no nested folders (flat layout).
ClassMethod DeriveNestingSpec(pSchemaClass As %String, Output pNestingSpec As %List) As %Status
{
	#dim tSC As %Status = $$$OK
	set pNestingSpec = ""
	Try {
		set tClassDef = ##class(%Dictionary.CompiledClass).%OpenId(pSchemaClass)
		if '$IsObject(tClassDef) {
			set tSC = $$$ERROR($$$GeneralError, "Cannot open compiled class: "_pSchemaClass)
			Quit
		}

		// Index the class's properties by name so storage entries can be typed.
		kill tPropType, tPropNode
		for i=1:1:tClassDef.Properties.Count() {
			set tProp = tClassDef.Properties.GetAt(i)
			set tPropType(tProp.Name) = tProp.Type
			set tNodeName = tProp.Parameters.GetAt("OPCUANODENAME")
			set tPropNode(tProp.Name) = $Select(tNodeName="":tProp.Name, 1:tNodeName)
		}

		set tEntries = tClassDef.Storages.GetAt(1).Data.GetAt(1).Values
		set tLeafIdx = 0
		set tHasNesting = 0

		for i=1:1:tEntries.Count() {
			set tName = tEntries.GetAt(i).Value
			continue:$Extract(tName,1)="%"
			continue:tName="NodePath"
			continue:tName="ServerTimeStamp"
			continue:tName="SourceTimeStamp"

			set tType = $Get(tPropType(tName))
			set tIsSerial = 0
			if (tType '= "") && ($Extract(tType,1)'="%") && ($Extract(tType,1,12)'="OPCUA.Types.") {
				Try {
					set tIsSerial = $classmethod(tType, "%Extends", "%SerialObject")
				} Catch (eInner) {
					set tIsSerial = 0
				}
			}

			if 'tIsSerial {
				set tLeafIdx = tLeafIdx + 1
				set pNestingSpec = pNestingSpec _ $LB($LB("leaf", tLeafIdx))
				continue
			}

			// A nested folder: one inner leaf per property of the serial class,
			// in the serial class's own storage order.
			set tHasNesting = 1
			set tInnerSpec = ""
			set tSerialDef = ##class(%Dictionary.CompiledClass).%OpenId(tType)
			if $IsObject(tSerialDef) {
				set tSerialEntries = tSerialDef.Storages.GetAt(1).Data.GetAt(1).Values
				for j=1:1:tSerialEntries.Count() {
					set tInnerName = tSerialEntries.GetAt(j).Value
					continue:$Extract(tInnerName,1)="%"
					set tLeafIdx = tLeafIdx + 1
					set tInnerSpec = tInnerSpec _ $LB($LB("leaf", tLeafIdx))
				}
			}
			set pNestingSpec = pNestingSpec _ $LB($LB("serial", $Get(tPropNode(tName), tName), tInnerSpec))
		}

		// A flat schema needs no nesting spec at all — the services treat "" as flat.
		if 'tHasNesting set pNestingSpec = ""

	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Resolve a schema and a device list into a concrete adapter specification by
/// browsing each device and matching children by name against OPCUANODENAME.
///
/// pClient must already be connected — browsing needs a live session, which is
/// why resolution happens from the adapter's Connect() rather than the service's
/// OnInit(). See OPCUA.Adapter.Common.ResolveSpecification().
///
/// Outputs:
///   pSpec        combined specification for ReadBulkSetupC / CreateSubscriptionSetB,
///                shaped exactly like the one the Projection produces:
///                $LB(dsName, storageGlobal, $LB("", entry1, entry2, ...))
///                with one entry per resolved column per device, devices in order
///   pMasks       $LB($LB(1,0,1,...), ...) — one discovered coverage mask per device,
///                in schema column order; bit 0 means "no such node on this device"
///   pDiagnostics $LB($LB(deviceLabel, columnNodeName, reason), ...) — unresolved
///                columns, for the caller to log
ClassMethod ResolveSpecification(pClient As OPCUA.Client, pSchemaClass As %String, pDevices As %List, Output pSpec As %List, Output pMasks As %List, Output pDiagnostics As %List, Output pBrowseOK As %List) As %Status
{
	#dim tSC As %Status = $$$OK
	set pSpec = ""
	set pMasks = ""
	set pDiagnostics = ""
	set pBrowseOK = ""
	Try {
		if '$IsObject($Get(pClient)) {
			set tSC = $$$ERROR($$$GeneralError, "ResolveSpecification requires a connected OPCUA.Client")
			Quit
		}

		set tSC = ..GetSchemaColumns(pSchemaClass, .tColumns, .tFolders)
		Quit:$$$ISERR(tSC)

		set tBaseSpec = $Get(^OPCUA.DataSource(pSchemaClass))
		set tDSName = $LI(tBaseSpec, 1)
		set tStorageGlobal = $LI(tBaseSpec, 2)

		set tEntries = $LB("")

		for iDev=1:1:$LL(pDevices) {
			set tDev = $LI(pDevices, iDev)
			set tDevNS = $LI(tDev, 1)
			set tDevId = $LI(tDev, 2)
			set tDevIdType = $LI(tDev, 3)
			set tDevLabel = $LI(tDev, 4)

			// --- Browse the device root, and each folder one level deeper ---
			kill tNameMap
			set tSCBrowse = ..BrowseIntoMap(pClient, tDevNS, tDevId, tDevIdType, .tNameMap)
			if $$$ISERR(tSCBrowse) {
				// A device that cannot be browsed contributes an all-zero mask:
				// its columns store NULL rather than failing the whole pipeline.
				set pDiagnostics = pDiagnostics _ $LB($LB(tDevLabel, "*", "device root could not be browsed: "_$System.Status.GetOneErrorText(tSCBrowse)))
			}

			// Whether the server answered the browse at all. Zero matches means
			// something quite different depending on this: a browsed device with no
			// matches is the wrong node, an unbrowsable one is simply unreachable.
			// Callers that gate on coverage need to tell those apart.
			set pBrowseOK = pBrowseOK _ $LB($$$ISOK(tSCBrowse))

			// Descend into each %SerialObject folder the schema declares.
			set tFolder = ""
			for {
				set tFolder = $Order(tFolders(tFolder))
				quit:tFolder=""
				set tFolderRef = $Get(tNameMap(..NameKey(tFolder)))
				if tFolderRef = "" {
					set pDiagnostics = pDiagnostics _ $LB($LB(tDevLabel, tFolder, "folder not found on device"))
					continue
				}
				kill tSubMap
				set tSCSub = ..BrowseIntoMap(pClient, $LI(tFolderRef, 1), $LI(tFolderRef, 2), $LI(tFolderRef, 3), .tSubMap)
				if $$$ISERR(tSCSub) {
					set pDiagnostics = pDiagnostics _ $LB($LB(tDevLabel, tFolder, "folder could not be browsed: "_$System.Status.GetOneErrorText(tSCSub)))
					continue
				}
				// Store folder children under a folder-qualified key.
				set tKey = ""
				for {
					set tKey = $Order(tSubMap(tKey))
					quit:tKey=""
					set tNameMap(..NameKey(tFolder), tKey) = tSubMap(tKey)
				}
			}

			// --- Match each schema column against the browsed names ---
			set tMask = ""
			for iCol=1:1:tColumns {
				set tCol = tColumns(iCol)
				set tNodeName = $LI(tCol, 3)
				set tAttrId = $LI(tCol, 4)
				set tFolderName = $LI(tCol, 5)

				if tFolderName = "" {
					set tRef = $Get(tNameMap(..NameKey(tNodeName)))
				} else {
					set tRef = $Get(tNameMap(..NameKey(tFolderName), ..NameKey(tNodeName)))
				}

				if tRef = "" {
					set tMask = tMask _ $LB(0)
					set tWhere = $Select(tFolderName="":tNodeName, 1:tFolderName_"/"_tNodeName)
					set pDiagnostics = pDiagnostics _ $LB($LB(tDevLabel, tWhere, "no child node matched this name"))
					continue
				}

				set tMask = tMask _ $LB(1)

				// Force type 2 so the C++ layer returns a full DataValue with
				// timestamps, matching what the row-source services expect.
				set tEntries = tEntries _ $LB($LB(
					2,
					$LI(tCol, 1)_"_RS"_iDev,
					$LI(tRef, 1),
					$LI(tRef, 2),
					tAttrId
				))
			}

			set pMasks = pMasks _ $LB(tMask)
		}

		set pSpec = $LB(tDSName, tStorageGlobal, tEntries)

	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Browse one node and index its children by name for lookup.
///
/// Both BrowseName and DisplayName are indexed, BrowseName winning when the two
/// disagree, so a schema whose OPCUANODENAME came from either one still resolves.
/// A duplicate name keeps the first match, deterministically (PRD risk table).
///
/// Output: pMap(nameKey) = $LB(ns, id, idType)
ClassMethod BrowseIntoMap(pClient As OPCUA.Client, pNS As %Integer, pId, pIdType As %Integer, Output pMap) As %Status
{
	#dim tSC As %Status = $$$OK
	kill pMap
	Try {
		set tSC = pClient.Browse(.tResults, $LB(pIdType), $LB(pNS), $LB(pId))
		Quit:$$$ISERR(tSC)

		set tCount = ##class(OPCUA.REST.BrowseService).WalkBrowseResults(tResults, .tChildren)

		// Two passes so BrowseName always wins over a colliding DisplayName.
		for i=1:1:tCount {
			set tChild = tChildren(i)
			set tBrowseName = $LI(tChild, 1)
			continue:tBrowseName=""
			set tKey = ..NameKey(tBrowseName)
			if '$Data(pMap(tKey)) {
				set pMap(tKey) = $LB($LI(tChild, 3), $LI(tChild, 4), $LI(tChild, 5))
			}
		}
		for i=1:1:tCount {
			set tChild = tChildren(i)
			set tDisplayName = $LI(tChild, 2)
			continue:tDisplayName=""
			set tKey = ..NameKey(tDisplayName)
			if '$Data(pMap(tKey)) {
				set pMap(tKey) = $LB($LI(tChild, 3), $LI(tChild, 4), $LI(tChild, 5))
			}
		}
	} Catch (e) {
		set tSC = e.AsStatus()
	}
	Quit tSC
}

/// Build the lookup key for a node name.
///
/// A BrowseName arrives from the server as "<namespaceIndex>:<name>" in some
/// stacks and bare in others, so strip any numeric namespace prefix. Matching is
/// case-sensitive, as OPC UA BrowseNames are.
ClassMethod NameKey(pName As %String) As %String [ CodeMode = expression ]
{
$Select($Piece(pName, ":", 1) ? 1.N: $Piece(pName, ":", 2, *), 1: pName)
}

}
