# The iris image builds with the repository root as its context (see
# docker-compose.yml), so everything not needed inside the image is excluded here.
# Without this, `docker compose build` uploads webapp/node_modules — several
# hundred megabytes — to the daemon on every build.

.git
.claude
.DS_Store
**/.DS_Store

# The Angular console is served separately and is not part of the IRIS image.
webapp

# Docs and design notes
docs
*.md
LICENSE

# Demo pieces the iris image does not use: the other image's build tree, the
# certificate generator (its outputs are copied into demo/iris/certs, which is
# deliberately not excluded), and the mock servers' bind-mounted data
demo/certified-server
demo/certgen
demo/mock-data

# Windows artefacts are for native installs, not the Linux image
backend/native/windows-x64
legacy

# The terminal installer runs outside IRIS; its build tree is hundreds of megabytes
# and local/ holds saved passwords
installer
