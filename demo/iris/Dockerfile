FROM intersystems/iris-community:2025.3

USER root
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends libmbedtls-dev && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /usr/irissys/uac/certs/trustdir /usr/irissys/uac/certs/crldir && \
    mkdir -p /usr/irissys/mgr/opcua /usr/irissys/mgr/opcua/opcuaenstemp /usr/irissys/mgr/opcua/opcuasecondary && \
    chown -R 51773:51773 /usr/irissys/mgr/opcua

USER irisowner

# Source code.
#
# Paths here are relative to the repository root, not to this Dockerfile:
# docker-compose.yml sets `context: .` so that the backend source, the prebuilt
# binaries and the generated certificates can live in their own top-level
# directories instead of being cornered inside the image directory. See
# .dockerignore for what that context deliberately excludes.
#
# Each source root mirrors package names, so they merge into one tree that
# IRISConfig.Installer loads with a single LoadDir.
COPY --chown=irisowner:irisgroup backend/src/      /opt/irisapp/src/
COPY --chown=irisowner:irisgroup backend/tests/    /opt/irisapp/src/
COPY --chown=irisowner:irisgroup backend/examples/ /opt/irisapp/src/
COPY --chown=irisowner:irisgroup demo/iris/IRISConfig/ /opt/irisapp/src/IRISConfig/

# C++ binaries, per architecture.
#
# TARGETARCH is supplied by BuildKit ("amd64" or "arm64"), so an Apple Silicon
# host gets the native arm64 libraries and an Intel host keeps the x86-64 ones.
# OPCUA.Utils looks the library up by name in the IRIS bin directory, so nothing
# in ObjectScript needs to know which architecture it is running on.
#
# Rebuild these with opc-ua-master/docker/Dockerfile.linux-arm64 (arm64) or the
# IrisOPCUA.mak lnxubuntux64 target (amd64).
ARG TARGETARCH
COPY --chown=irisowner:irisgroup backend/native/linux-${TARGETARCH}/ /usr/irissys/bin/

# TLS certificates (readable by IRIS process). Generated by demo/certgen/generate.sh,
# which must run before the first build — these files are gitignored, so a fresh
# clone has no certs/ directory and this COPY is what fails if it is skipped.
COPY --chown=irisowner:irisgroup demo/iris/certs/secuac.crt.der /usr/irissys/uac/certs/
COPY --chown=irisowner:irisgroup demo/iris/certs/secuac.key.der /usr/irissys/uac/certs/
COPY --chown=irisowner:irisgroup demo/iris/certs/myCA.crt.der   /usr/irissys/uac/certs/trustdir/
COPY --chown=irisowner:irisgroup demo/iris/certs/myCA.crl       /usr/irissys/uac/certs/crldir/

# Install script (credentials + ObjectScript commands)
COPY --chown=irisowner:irisgroup demo/iris/iris-install.script /tmp/iris-install.script

# Start IRIS, run installer, stop IRIS
RUN iris start IRIS && \
    iris session IRIS -U %SYS < /tmp/iris-install.script && \
    iris stop IRIS quietly
